generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}
enum VendorType {
  INDIVIDUAL
  BUSINESS
}
enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
  TERMINATED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}
enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  DISABLED
  ARCHIVED
}
enum ProductKind {
  SIMPLE
  VARIABLE
}
enum OrderStatus {
  NEW
  PROCESSING
  READY_TO_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}
enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_VENDOR
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}
enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  ON_HOLD
}
enum DiscountType {
  PERCENTAGE
  FIXED
}

model Customer {
  id String @id @default(cuid())
  mobile String @unique
  name String?
  email String?
  status UserStatus @default(ACTIVE)
  preferredLanguage String @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addresses Address[]
  orders Order[]
  reviews Review[]
  tickets SupportTicket[]
}
model Address {
  id String @id @default(cuid())
  customerId String
  recipientName String
  mobile String
  line1 String
  line2 String?
  city String
  district String
  state String
  pincode String
  country String @default("India")
  isDefault Boolean @default(false)
  customer Customer @relation(fields:[customerId], references:[id])
  createdAt DateTime @default(now())
}
model Vendor {
  id String @id @default(cuid())
  name String
  storeSlug String @unique
  type VendorType
  status VendorStatus @default(PENDING)
  email String?
  mobile String?
  gstRegistered Boolean @default(false)
  gstin String?
  address Json?
  bankDetails Json?
  contactPrivate Json?
  commissionRate Decimal? @db.Decimal(7,4)
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
  suborders VendorSuborder[]
  documents VendorDocument[]
}
model VendorDocument {
  id String @id @default(cuid())
  vendorId String
  kind String
  fileUrl String
  status ApprovalStatus @default(PENDING)
  reviewerNote String?
  createdAt DateTime @default(now())
  vendor Vendor @relation(fields:[vendorId], references:[id])
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  parentId String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  parent Category? @relation("CategoryTree", fields:[parentId], references:[id])
  children Category[] @relation("CategoryTree")
  products Product[]
  attributes CategoryAttribute[]
}
model Brand {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  logoUrl String?
  description String?
  website String?
  isApproved Boolean @default(true)
  createdAt DateTime @default(now())
  products Product[]
}
model CategoryAttribute {
  id String @id @default(cuid())
  categoryId String
  name String
  dataType String
  options Json?
  isRequired Boolean @default(false)
  isFilterable Boolean @default(false)
  isVariation Boolean @default(false)
  category Category @relation(fields:[categoryId], references:[id])
}
model VendorCategoryPermission {
  id String @id @default(cuid())
  vendorId String
  categoryId String
  status ApprovalStatus @default(PENDING)
  @@unique([vendorId, categoryId])
}
model Product {
  id String @id @default(cuid())
  vendorId String
  categoryId String
  brandId String?
  title String
  slug String @unique
  description String? @db.LongText
  kind ProductKind @default(SIMPLE)
  status ProductStatus @default(DRAFT)
  approvedSnapshot Json?
  pendingSnapshot Json?
  regularPrice Decimal @db.Decimal(12,2)
  salePrice Decimal? @db.Decimal(12,2)
  saleStartsAt DateTime?
  saleEndsAt DateTime?
  sku String?
  stock Int @default(0)
  lowStockThreshold Int @default(5)
  weightGrams Int?
  attributes Json?
  images Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor Vendor @relation(fields:[vendorId], references:[id])
  category Category @relation(fields:[categoryId], references:[id])
  brand Brand? @relation(fields:[brandId], references:[id])
  variations ProductVariation[]
  reviews Review[]
  @@index([vendorId,status])
  @@index([categoryId,status])
}
model ProductVariation {
  id String @id @default(cuid())
  productId String
  sku String?
  attributes Json
  price Decimal @db.Decimal(12,2)
  stock Int @default(0)
  imageUrl String?
  weightGrams Int?
  product Product @relation(fields:[productId], references:[id])
  @@index([productId])
}
model Cart {
  id String @id @default(cuid())
  customerId String @unique
  items Json
  updatedAt DateTime @updatedAt
}
model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  customerId String
  status OrderStatus @default(NEW)
  paymentStatus PaymentStatus @default(INITIATED)
  subtotal Decimal @db.Decimal(12,2)
  discountTotal Decimal @default(0) @db.Decimal(12,2)
  shippingTotal Decimal @default(0) @db.Decimal(12,2)
  taxTotal Decimal @default(0) @db.Decimal(12,2)
  grandTotal Decimal @db.Decimal(12,2)
  shippingAddress Json
  snapshot Json?
  createdAt DateTime @default(now())
  customer Customer @relation(fields:[customerId], references:[id])
  suborders VendorSuborder[]
  payment Payment?
}
model VendorSuborder {
  id String @id @default(cuid())
  orderId String
  vendorId String
  status OrderStatus @default(NEW)
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  shipping Decimal @default(0) @db.Decimal(12,2)
  tax Decimal @default(0) @db.Decimal(12,2)
  commission Decimal @default(0) @db.Decimal(12,2)
  vendorPayable Decimal @default(0) @db.Decimal(12,2)
  tracking Json?
  order Order @relation(fields:[orderId], references:[id])
  vendor Vendor @relation(fields:[vendorId], references:[id])
  items OrderItem[]
  @@index([vendorId,status])
}
model OrderItem {
  id String @id @default(cuid())
  suborderId String
  productId String
  variationId String?
  titleSnapshot String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  tax Decimal @default(0) @db.Decimal(12,2)
  commission Decimal @default(0) @db.Decimal(12,2)
  suborder VendorSuborder @relation(fields:[suborderId], references:[id])
}
model Payment {
  id String @id @default(cuid())
  orderId String @unique
  provider String
  providerOrderId String?
  providerPaymentId String?
  amount Decimal @db.Decimal(12,2)
  status PaymentStatus @default(INITIATED)
  rawResponse Json?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id])
}
model LedgerEntry {
  id String @id @default(cuid())
  vendorId String?
  orderId String?
  suborderId String?
  type String
  direction String
  amount Decimal @db.Decimal(14,2)
  currency String @default("INR")
  reference String?
  description String?
  availableAt DateTime?
  createdAt DateTime @default(now())
  @@index([vendorId,createdAt])
  @@index([orderId])
}
model Payout {
  id String @id @default(cuid())
  vendorId String
  amount Decimal @db.Decimal(14,2)
  status PayoutStatus @default(PENDING)
  periodStart DateTime?
  periodEnd DateTime?
  transactionReference String?
  adminNote String?
  createdAt DateTime @default(now())
  paidAt DateTime?
}
model Coupon {
  id String @id @default(cuid())
  code String @unique
  vendorId String?
  discountType DiscountType
  value Decimal @db.Decimal(10,2)
  minOrder Decimal? @db.Decimal(12,2)
  maxDiscount Decimal? @db.Decimal(12,2)
  startsAt DateTime?
  endsAt DateTime?
  usageLimit Int?
  usageCount Int @default(0)
  isActive Boolean @default(true)
}
model Review {
  id String @id @default(cuid())
  customerId String
  productId String
  rating Int
  content String?
  imageUrls Json?
  verifiedPurchase Boolean @default(false)
  isVisible Boolean @default(false)
  vendorReply String?
  vendorReplyAt DateTime?
  createdAt DateTime @default(now())
  customer Customer @relation(fields:[customerId], references:[id])
  product Product @relation(fields:[productId], references:[id])
}
model SupportTicket {
  id String @id @default(cuid())
  ticketNumber String @unique
  customerId String
  category String
  subject String
  status TicketStatus @default(OPEN)
  priority String @default("NORMAL")
  assignedVendorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields:[customerId], references:[id])
  messages TicketMessage[]
}
model TicketMessage {
  id String @id @default(cuid())
  ticketId String
  authorType String
  authorId String
  body String
  attachments Json?
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())
  ticket SupportTicket @relation(fields:[ticketId], references:[id])
}
model Notification {
  id String @id @default(cuid())
  recipientType String
  recipientId String
  channel String
  title String
  body String?
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([recipientType,recipientId,readAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorType String
  actorId String
  action String
  entityType String
  entityId String?
  reason String?
  before Json?
  after Json?
  ipAddress String?
  createdAt DateTime @default(now())
  @@index([entityType,entityId])
  @@index([createdAt])
}
model OtpChallenge {
  id String @id @default(cuid())
  mobile String
  codeHash String
  expiresAt DateTime
  consumedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([mobile,createdAt])
}

